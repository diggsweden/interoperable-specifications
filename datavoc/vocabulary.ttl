@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

@prefix inspec: <https://w3id.org/inspec/datavoc/> .

inspec: a owl:Ontology ;
  rdfs:label "The Interoperable Specifications Profile (INSPEC) Vocabulary"@en ;
  rdfs:comment "This vocabulary defines terms used in INSPEC."@en .

inspec:PROF a dcterms:Standard ;
  rdfs:label "PROF"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "This is a specification corresponding to a profile of PROF used to capture an interoperable specification. Corresponds to the PROF rules."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/dx-prof/> .

inspec:RDFS a dcterms:Standard ;
  rdfs:label "RDFS"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "This is a specification corresponding to a profile of RDFS used to capture an expression of data vocabularies. Corresponds to the DV rules."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/rdf12-schema/> .

inspec:SKOS a dcterms:Standard ;
  rdfs:label "SKOS"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "This is a specification corresponding to a profile of SKOS used to capture an expression of terminologies. Corresponds to the TE rules."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/skos-reference/> .

inspec:SHACL a dcterms:Standard ;
  rdfs:label "SHACL"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "This is a specification corresponding to a profile of SHACL used to capture an expression of application profiles. Corresponds to the AP rules."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/shacl> .

inspec:SVG a dcterms:Standard ;
  rdfs:label "SVG"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "This is a specification corresponding to a profile of SVG used to capture an expression of diagrams for interoperable specifications. Corresponds to the SVG rules."@en ;
  rdfs:seeAlso <https://www.w3.org/TR/SVG11/> .

inspec:UML a dcterms:Standard ;
  rdfs:label "UML"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "This is a specification corresponding to a profile of UML used to capture the source model of an interoperable specification. The model follows the INSPEC UML tag convention, so that interoperable specification parts can be extracted from it. Corresponds to the relevant EXTRACT rules."@en ;
  rdfs:seeAlso <https://www.omg.org/spec/UML/> .

inspec:umlOntology a rdf:Property ;
  rdfs:label "UML ontology"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "A data vocabulary to extract from the UML model, identified by the URI of its data vocabulary resource. The data vocabulary is extracted from the terms introduced by the model's package whose ontologyURI tag, or else baseURI tag, is this URI. Repeat the property for each data vocabulary."@en ;
  rdfs:domain prof:ResourceDescriptor ;
  rdfs:range owl:Ontology .

inspec:umlDiagram a rdf:Property ;
  rdfs:label "UML diagram"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "The diagram, identified by name or GUID, in the UML model from which the application profile is extracted."@en ;
  rdfs:domain prof:ResourceDescriptor ;
  rdfs:range rdfs:Literal .

inspec:variant a rdf:Property ;
  rdfs:label "variant"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "A shape or profile is a variant of another if it relaxes some of its constraints"@en ;
  rdfs:subPropertyOf dcterms:relation ;
  rdfs:domain [
	  owl:unionOf (sh:Shape prof:Profile)
    ] ;
  rdfs:range [
	  owl:unionOf (sh:Shape prof:Profile)
    ].

inspec:refines a rdf:Property ;
  rdfs:label "refines"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "A shape refines another by adding additional constraints to it"@en ;
  rdfs:subPropertyOf dcterms:relation ;
  rdfs:domain [
	  owl:unionOf (sh:Shape prof:Profile)
    ] ;
  rdfs:range [
	  owl:unionOf (sh:Shape prof:Profile)
    ].

inspec:reuses a rdf:Property ;
  rdfs:label "reuses"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "A specification reuses a resource if it is needed by the specification but was originally introduced by a different specification"@en ;
  rdfs:subPropertyOf dcterms:relation ;
  rdfs:domain dcterms:Standard ;
  rdfs:range rdfs:Resource .

inspec:introduces a rdf:Property ;
  rdfs:label "introduces"@en ;
  rdfs:isDefinedBy inspec: ;
  rdfs:comment "A specification introduces a resource if it is first introduced by a the same specification"@en ;
  rdfs:subPropertyOf dcterms:relation ;
  rdfs:domain dcterms:Standard ;
  rdfs:range rdfs:Resource .
